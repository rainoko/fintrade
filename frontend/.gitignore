# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*storybook.log
storybook-static

# Playwright e2e suite (playwright.config.ts, tests/e2e/) -- report/artifacts only,
# never the spec files themselves.
/playwright-report
/test-results
/blob-report
/playwright/.cache

# Yarn Berry (nodeLinker: node-modules, see .yarnrc.yml) -- keep the vendored release
# binary (yarn-*.cjs) so `yarn` works with no network fetch, but not the regenerated
# install-state cache or a local package cache should one ever appear (this project
# uses Yarn's global cache by default, so /.yarn/cache shouldn't normally exist here).
/.yarn/*
!/.yarn/releases
/.yarn/install-state.gz
